# Local secrets — copy to .env and/or .dev.vars (both gitignored).
# Production: set on Cloudflare Pages → Environment variables / secrets.

# Ask AI providers (at least one required)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-3-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ASK_DEFAULT_PROVIDER=gemini

# Optional
# VITE_ASK_API_BASE=/api/ask
