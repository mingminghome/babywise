# Local secrets — copy to .env and/or .dev.vars (both gitignored).
# Production: Cloudflare Pages secrets for Functions; GitHub Actions *variables*
# for any VITE_* value (Vite inlines them at `npm run build`).

# --- Client / Vite build-time ---
# Google Tag Manager container ID (optional). Empty = GTM off.
# Production: GitHub → Settings → Secrets and variables → Actions → Variables.
# Example: VITE_GTM_ID=GTM-XXXXXXX
# Wire GA4 (G-…) inside the GTM container; do not put a G- id here.
VITE_GTM_ID=

# “Buy me a pint” support link (optional). Leave empty to hide the UI.
# Example: VITE_BUY_ME_A_PINT_URL=https://buymeacoffee.com/your-slug
VITE_BUY_ME_A_PINT_URL=
# Optional custom button image; if empty, BMC slug URLs get a default button image.
# VITE_BUY_ME_A_PINT_IMG=

# Optional
# VITE_ASK_API_BASE=/api/ask

# --- Server (prefer .dev.vars for `pages:dev`; Pages secrets in production) ---
# Ask AI providers (at least one required)
GEMINI_API_KEY=
# OPENAI_API_KEY=
# XAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional model overrides
# GEMINI_MODEL=gemini-flash-lite-latest
# OPENAI_MODEL=gpt-4o-mini
# XAI_MODEL=grok-3-mini
# ANTHROPIC_MODEL=claude-3-5-haiku-latest
# ASK_DEFAULT_PROVIDER=gemini
