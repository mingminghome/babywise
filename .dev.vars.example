# Copy to .dev.vars for `npm run pages:dev` (wrangler loads this file).

# At least one provider key is required for Ask.
# Gemini (Google AI Studio free tier)
GEMINI_API_KEY=

# OpenAI
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Grok (xAI) — XAI_API_KEY or GROK_API_KEY
# XAI_API_KEY=
# XAI_MODEL=grok-3-mini

# Claude (Anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional defaults
# GEMINI_MODEL=gemini-flash-lite-latest
# ASK_DEFAULT_PROVIDER=gemini
